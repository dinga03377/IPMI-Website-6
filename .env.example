# PostgreSQL: required for production. Use a managed PostgreSQL URL in production.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql://ipmi:replace-with-a-long-random-local-password@127.0.0.1:5432/ipmi
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# API
PORT=8080
NODE_ENV=development
APP_VERSION=6.1.0
SESSION_TTL_MS=28800000
PG_POOL_MAX=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
VITE_API_BASE_URL=http://localhost:8080

# Bootstrap a first administrator once, before deployment. Use a unique password >=16 characters.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-unique-random-password-at-least-16-chars
